{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sayit",
  "version": "0.2.0",
  "identifier": "com.sayit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "",
        "width": 520,
        "height": 170,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focusable": false,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Sayit 设置",
        "width": 760,
        "height": 680,
        "minWidth": 700,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
